# Pinned OSS CAD Suite unpacked in-tree by the container image (never committed)
oss-cad-suite/

# Per-test debug logs written by `make <env> VERBOSE=1|2` (see README)
logs/

# Metrics (F3).  The captured artifacts `make metrics` reads are TRANSIENT and
# per-run — gate logs, /usr/bin/time output, the swarm stream-json.  The
# database and the rendered dashboard are the DELIVERABLES and ARE committed
# (see README "Metrics & dashboard"), so do not add them here.
metrics/_capture/
