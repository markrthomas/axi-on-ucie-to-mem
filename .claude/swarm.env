# .claude/swarm.env — this repo's profile for the shared DV swarm kit (markrthomas/dv-swarm-kit).
# See the kit's templates/swarm.env.example for what each key means. Environment variables override these.

PROJECT=axi-on-ucie-to-mem
GH_REPO=markrthomas/axi-on-ucie-to-mem
DUT_TOP=axi_ucie_mem_top

RTL_DIR=rtl
TB_DIR=dv

# the 8-env gate (CLAUDE.md "DV env map"), with `sv` split into its three make targets
DV_ENVS="test-all sv vlt sva-mut pack act reorder ooo mrp systemc"
GATE_TARGET=check
CI_TARGET=ci
CROSSCHECK_TARGET=
INFRA_TARGETS="formal coverage eda-check"
HEAVY_TARGETS="vlt coverage formal regress ci"

MUTATION_FILE=rtl/aou_axi_target_bridge.sv
MUTATION_HINT="corrupt one data bit on the read-response path, or drop one credit return"

RR_DIR=dv/random
RR_STATUS=bootstrap

METRICS=no

# Verilator cc1plus builds are memory-bound on cloud builders: at most 2 env testers at once (was docker/swarm.sh)
SWARM_MAX_PARALLEL=2
# repo-owned: daily 09:00 UTC Railway cron
KIT_KEEP="railway.toml"
